# ==============================================================================
# SERVER & ENVIRONMENT CONFIGURATION
# ==============================================================================
NODE_ENV="development" # Environment: "development" | "production" | "test"
PORT="3005"
SERVICE_NAME="havendor-admin-api" # Microservice name: "havendor-admin-api"
CORS_ALLOWED_ORIGINS='["http://localhost:3001","https://admin.havendor.com","https://www.admin.havendor.com"]'

# ==============================================================================
# DATABASE & CACHING
# ==============================================================================
DATABASE_URL="postgresql://user:password@localhost:5432/havendor_admin?sslmode=prefer" # PostgreSQL connection string
REDIS_URL="redis://localhost:6379" # Redis connection URL

# ==============================================================================
# SECURITY & AUTHENTICATION
# ==============================================================================
ENCRYPTION_KEY="" # 64-byte hex random string (Must be identical across all microservices)
HASH_PEPPER="" # Random secret string for hashing tokens
INTERNAL_SERVICE_SECRET="" # Secret string for authenticating internal service-to-service requests
JWT_SECRET="" # Secret key for signing JWT tokens
JWT_ACCESS_EXPIRES="900" # Access token expiration time in seconds (e.g. 900 = 15 minutes)
REFRESH_EXPIRES="2592000" # Refresh token expiration time in seconds (e.g. 2592000 = 30 days)
REMEMBER_ME_EXPIRES="2592000" # Remember Me token expiration time in seconds (e.g. 2592000 = 30 days)

# ==============================================================================
# EMAIL / SMTP CONFIGURATION
# ==============================================================================
SMTP_HOST="smtp.gmail.com" # SMTP server hostname (e.g. smtp.resend.com or smtp.gmail.com)
SMTP_PORT="587" # SMTP port (e.g. 587 or 465)
SMTP_USER="" # SMTP authentication user / API account
SMTP_PASS="" # SMTP authentication password / API key
EMAIL_DOMAIN="havendor.com" # Default email sender domain

# ==============================================================================
# S3 & FILE UPLOAD CONFIGURATION
# ==============================================================================
IMAGE_SERVER="https://verdin.devabir.site" # Base URL for serving public upload images
S3_ENDPOINT="https://fe04158d1c7ed5bb5b5ef7a9a7a619b5.r2.cloudflarestorage.com" # S3 / Cloudflare R2 endpoint URL
S3_ACCESS_KEY_ID="" # S3 access key ID
S3_SECRET_ACCESS_KEY="" # S3 secret access key
S3_DEFAULT_BUCKET="verdin" # Public S3 bucket name
S3_PRIVATE_BUCKET="havendor-private" # Private S3 bucket name
UPLOAD_IMAGE_FORMAT=".jpg,.jpeg,.png,.ico,.webp,.svg,.avif" # Allowed upload image formats
UPLOAD_IMAGE_SIZE="1048576" # Max file upload size in bytes (1048576 = 1MB)

# ==============================================================================
# FRONTEND & API URLS
# ==============================================================================
STAGING_FRONTEND_URL="https://staging.havendor.com"
TENANT_FRONTEND_URL="http://localhost:3000"
PUBLIC_API_BASE_URL="http://localhost:5000"

# ==============================================================================
# PAYMENT GATEWAYS (OPTIONAL)
# ==============================================================================
STRIPE_SECRET_KEY="" # Stripe secret API key (e.g. sk_test_...)
STRIPE_WEBHOOK_SECRET="" # Stripe webhook signing secret (e.g. whsec_...)
STRIPE_PUBLISHABLE_KEY="" # Stripe publishable API key (e.g. pk_test_...)
SSLCOMMERZ_STORE_ID="" # SSLCommerz store ID
SSLCOMMERZ_STORE_PASSWORD="" # SSLCommerz store password
SSLCOMMERZ_IS_LIVE="false" # SSLCommerz live environment toggle: "true" | "false"

# ==============================================================================
# PACKAGE REGISTRY & LOGGING
# ==============================================================================
NPM_TOKEN="" # GitHub PAT with read:packages scope for private @havendor packages
ENABLE_FILE_LOGGING="true" # Enable logging to file system: "true" | "false"