    "prepare": "node ./.husky/install.mjs",
    "db:seed": "tsx -r tsconfig-paths/register ./src/seed-runner.ts",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "postinstall": "node ./src/postinstall.mjs"
  },
